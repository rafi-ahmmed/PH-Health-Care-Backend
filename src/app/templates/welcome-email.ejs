<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Welcome to PH Health Care</title>
</head>

<body style="
  margin: 0;
  padding: 0;
  background-color: #f4f7fb;
  font-family: Arial, Helvetica, sans-serif;
">

  <div style="
    max-width: 600px;
    margin: 40px auto;
    background-color: #ffffff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  ">

    <!-- Header -->
    <div style="
      background-color: #2563eb;
      padding: 35px 20px;
      text-align: center;
    ">
      <h1 style="
        margin: 0;
        color: #ffffff;
        font-size: 30px;
      ">
        PH Health Care
      </h1>

      <p style="
        margin: 10px 0 0;
        color: #dbeafe;
        font-size: 15px;
      ">
        Your Health, Our Priority
      </p>
    </div>

    <!-- Content -->
    <div style="
      padding: 45px 30px;
      text-align: center;
    ">

      <div style="
        width: 75px;
        height: 75px;
        margin: 0 auto 25px;
        background-color: #dcfce7;
        border-radius: 50%;
        line-height: 75px;
        font-size: 36px;
      ">
        👋
      </div>

      <h2 style="
        margin: 0 0 15px;
        color: #1e293b;
        font-size: 27px;
      ">
        Welcome, <%= name %>!
      </h2>

      <p style="
        margin: 0 auto 25px;
        color: #64748b;
        font-size: 16px;
        line-height: 1.7;
      ">
        We're happy to have you with us.
        Your PH Health Care account has been
        successfully created and verified.
      </p>

      <!-- Account Information -->
      <div style="
        padding: 20px;
        margin: 25px 0;
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        text-align: left;
      ">

        <p style="
          margin: 0 0 12px;
          color: #64748b;
          font-size: 13px;
        ">
          ACCOUNT INFORMATION
        </p>

        <p style="
          margin: 0 0 10px;
          color: #1e293b;
          font-size: 15px;
        ">
          <strong>Name:</strong>
          <%= name %>
        </p>

        <p style="
          margin: 0;
          color: #1e293b;
          font-size: 15px;
          word-break: break-word;
        ">
          <strong>Email:</strong>
          <%= email %>
        </p>

      </div>

      <!-- Welcome Message -->
      <div style="
        padding: 20px;
        margin: 25px 0;
        background-color: #eff6ff;
        border-radius: 10px;
        border-left: 4px solid #2563eb;
        text-align: left;
      ">
        <p style="
          margin: 0;
          color: #1e40af;
          font-size: 15px;
          line-height: 1.7;
        ">
          <strong>You're all set!</strong><br>
          You can now securely access your PH Health Care
          account and explore our healthcare services.
        </p>
      </div>

      <p style="
        margin: 30px 0 0;
        color: #64748b;
        font-size: 15px;
        line-height: 1.6;
      ">
        Thank you for choosing
        <strong style="color: #2563eb;">
          PH Health Care
        </strong>.
        We're here to make your healthcare experience
        simple and secure.
      </p>

    </div>

    <!-- Footer -->
    <div style="
      padding: 22px;
      background-color: #f8fafc;
      text-align: center;
      border-top: 1px solid #e2e8f0;
    ">

      <p style="
        margin: 0;
        color: #64748b;
        font-size: 13px;
      ">
        Best regards,<br>

        <strong style="color: #2563eb;">
          PH Health Care Team
        </strong>
      </p>

      <p style="
        margin: 15px 0 0;
        color: #94a3b8;
        font-size: 12px;
      ">
        © 2026 PH Health Care. All rights reserved.
      </p>

    </div>

  </div>

</body>
</html>