<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PH Health Care - Password Reset Successful</title>
</head>

<body style="
  margin: 0;
  padding: 0;
  background-color: #f4f7fb;
  font-family: Arial, Helvetica, sans-serif;
">

  <div style="
    max-width: 600px;
    margin: 40px auto;
    background-color: #ffffff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  ">

    <!-- Header -->
    <div style="
      background-color: #2563eb;
      padding: 30px 20px;
      text-align: center;
    ">
      <h1 style="
        margin: 0;
        color: #ffffff;
        font-size: 28px;
      ">
        PH Health Care
      </h1>

      <p style="
        margin: 10px 0 0;
        color: #dbeafe;
        font-size: 15px;
      ">
        Secure Healthcare Service
      </p>
    </div>

    <!-- Content -->
    <div style="
      padding: 45px 30px;
      text-align: center;
    ">

      <!-- Success Icon -->
      <div style="
        width: 70px;
        height: 70px;
        margin: 0 auto 25px;
        background-color: #dcfce7;
        border-radius: 50%;
        line-height: 70px;
        font-size: 36px;
        color: #16a34a;
      ">
        ✓
      </div>

      <h2 style="
        margin: 0 0 15px;
        color: #1e293b;
        font-size: 26px;
      ">
        Password Reset Successful!
      </h2>

      <p style="
        margin: 0 auto 25px;
        color: #64748b;
        font-size: 16px;
        line-height: 1.7;
      ">
        Your PH Health Care account password has been
        successfully reset.
      </p>

      <!-- Success Message -->
      <div style="
        padding: 18px 20px;
        margin: 25px 0;
        background-color: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-radius: 8px;
        text-align: left;
      ">
        <p style="
          margin: 0;
          color: #166534;
          font-size: 14px;
          line-height: 1.6;
        ">
          <strong>Password Updated</strong><br>
          You can now use your new password to securely
          sign in to your PH Health Care account.
        </p>
      </div>

      <!-- Security Notice -->
      <div style="
        padding: 15px 20px;
        background-color: #eff6ff;
        border-radius: 8px;
        border-left: 4px solid #2563eb;
        text-align: left;
      ">
        <p style="
          margin: 0;
          color: #1e40af;
          font-size: 14px;
          line-height: 1.6;
        ">
          <strong>Security Reminder:</strong><br>
          If you did not make this change, please contact
          PH Health Care support immediately and secure your account.
        </p>
      </div>

      <p style="
        margin: 30px 0 0;
        color: #94a3b8;
        font-size: 13px;
        line-height: 1.5;
      ">
        Thank you for choosing PH Health Care.
      </p>

    </div>

    <!-- Footer -->
    <div style="
      padding: 20px;
      background-color: #f8fafc;
      text-align: center;
      border-top: 1px solid #e2e8f0;
    ">

      <p style="
        margin: 0;
        color: #64748b;
        font-size: 13px;
      ">
        Thanks,<br>

        <strong style="color: #2563eb;">
          PH Health Care Team
        </strong>
      </p>

      <p style="
        margin: 15px 0 0;
        color: #94a3b8;
        font-size: 12px;
      ">
        © 2026 PH Health Care. All rights reserved.
      </p>

    </div>

  </div>

</body>
</html>