<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PH Health Care - Verify Your Email</title>
</head>

<body style="
  margin: 0;
  padding: 0;
  background-color: #f4f7fb;
  font-family: Arial, Helvetica, sans-serif;
">

  <div style="
    max-width: 600px;
    margin: 40px auto;
    background-color: #ffffff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  ">

    <!-- Header -->
    <div style="
      background-color: #2563eb;
      padding: 30px 20px;
      text-align: center;
    ">
      <h1 style="
        margin: 0;
        color: #ffffff;
        font-size: 28px;
      ">
        PH Health Care
      </h1>

      <p style="
        margin: 10px 0 0;
        color: #dbeafe;
        font-size: 15px;
      ">
        Welcome to PH Health Care
      </p>
    </div>

    <!-- Content -->
    <div style="
      padding: 40px 30px;
      text-align: center;
    ">

      <!-- Email Icon -->
      <div style="
        width: 70px;
        height: 70px;
        margin: 0 auto 25px;
        background-color: #eff6ff;
        border-radius: 50%;
        line-height: 70px;
        font-size: 32px;
      ">
        ✉
      </div>

      <h2 style="
        margin: 0 0 15px;
        color: #1e293b;
        font-size: 26px;
      ">
        Verify Your Email
      </h2>

      <p style="
        margin: 0 auto 25px;
        color: #64748b;
        font-size: 16px;
        line-height: 1.7;
      ">
        Thank you for registering with
        <strong style="color: #2563eb;">
          PH Health Care
        </strong>.
        Please use the verification code below to verify your email address.
      </p>

      <!-- OTP -->
      <div style="
        display: inline-block;
        padding: 18px 35px;
        margin: 10px 0 25px;
        background-color: #eff6ff;
        border: 2px dashed #2563eb;
        border-radius: 10px;
      ">
        <span style="
          color: #2563eb;
          font-size: 32px;
          font-weight: bold;
          letter-spacing: 8px;
        ">
          <%= otp %>
        </span>
      </div>

      <p style="
        margin: 0 0 25px;
        color: #64748b;
        font-size: 14px;
      ">
        This verification code is valid for
        <strong style="color: #2563eb;">
          5 minutes
        </strong>.
      </p>

      <!-- Security Notice -->
      <div style="
        padding: 15px 20px;
        background-color: #fefce8;
        border-radius: 8px;
        border-left: 4px solid #eab308;
        text-align: left;
      ">
        <p style="
          margin: 0;
          color: #713f12;
          font-size: 14px;
          line-height: 1.6;
        ">
          <strong>Security Notice:</strong><br>
          Never share this verification code with anyone.
          PH Health Care will never ask you for your OTP.
        </p>
      </div>

      <p style="
        margin: 30px 0 0;
        color: #94a3b8;
        font-size: 13px;
        line-height: 1.5;
      ">
        If you did not create an account with PH Health Care,
        you can safely ignore this email.
      </p>

    </div>

    <!-- Footer -->
    <div style="
      padding: 20px;
      background-color: #f8fafc;
      text-align: center;
      border-top: 1px solid #e2e8f0;
    ">

      <p style="
        margin: 0;
        color: #64748b;
        font-size: 13px;
      ">
        Thanks,<br>

        <strong style="color: #2563eb;">
          PH Health Care Team
        </strong>
      </p>

      <p style="
        margin: 15px 0 0;
        color: #94a3b8;
        font-size: 12px;
      ">
        © 2026 PH Health Care. All rights reserved.
      </p>

    </div>

  </div>

</body>
</html>